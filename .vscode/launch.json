{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EIGUIT",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "EIGUIT - Estudo de Tempo (sozinho)",
            "type": "debugpy",
            "request": "launch",
            "module": "Estudos.estudo_tempo",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal"
        }
    ]
}
